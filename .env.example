# Railway Postgres connection URL
DATABASE_URL=postgresql://postgres:password@host.railway.app:5432/railway
# Optional: set false if your DB/proxy does not support SSL
DATABASE_SSL=false

# Admin auth session signing secret (set a long random string in production)
ADMIN_SESSION_SECRET=replace-with-long-random-secret

# Seeder variables for `npm run seed:admin`
ADMIN_SEED_EMAIL=admin@brandscafe.com
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_NAME=Admin User

# --- PayFast (Apps.net.pk) — must live in project root `.env.local` (not under src/)
# Direct token (recommended): POST GetAccessToken with query string
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
# Optional; default PKR
PAYFAST_CURRENCY_CODE=PKR
# Optional display / PostTransaction
PAYFAST_MERCHANT_DISPLAY_NAME=BrandsFace
PAYFAST_TXN_DESC=BrandsFace product order
# Public site URL for success/failure/IPN links in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: show "Phone *" on PDP when you use PayFast
NEXT_PUBLIC_PAYFAST_CHECKOUT=1

# Alternative: custom backend that returns MERCHANT_ID + ACCESS_TOKEN (omit merchant+secured above)
# PAYFAST_ACCESS_TOKEN_URL=
# PAYFAST_TOKEN_AUTH_HEADER=
