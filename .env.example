# Railway Postgres connection URL
DATABASE_URL=postgresql://postgres:password@host.railway.app:5432/railway
# Optional: set false if your DB/proxy does not support SSL
DATABASE_SSL=false

# Admin auth session signing secret (set a long random string in production)
ADMIN_SESSION_SECRET=replace-with-long-random-secret

# Seeder variables for `npm run seed:admin`
ADMIN_SEED_EMAIL=admin@brandscafe.com
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_NAME=Admin User

# --- PayFast (Apps.net.pk) — must live in project root `.env.local` (not under src/)
# Direct token (recommended): POST GetAccessToken with query string
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
# Optional; default PKR
PAYFAST_CURRENCY_CODE=PKR
# Optional display / PostTransaction
PAYFAST_MERCHANT_DISPLAY_NAME=BrandsFace
PAYFAST_TXN_DESC=BrandsFace product order
# Public site URL for success/failure/IPN links in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Resend (invoice emails from admin panel)
# Must live in project root `.env.local` — Next.js does NOT load env from src/
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@brandsface.com
SENDER_NAME=Brands Face
# Optional: defaults to NEXT_PUBLIC_CONTACT_EMAIL if unset
# NEXT_PUBLIC_CONTACT_EMAIL=info@brandsface.com

# --- AWS S3 (quote / audit file uploads)
# Must live in project root `.env.local`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Optional: CloudFront or custom CDN base (no trailing slash)
# AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com
# Optional object ACL if bucket allows ACLs (e.g. public-read). Prefer bucket policy instead.
# AWS_S3_OBJECT_ACL=public-read
# Folder prefix for quote images — must match your bucket policy Resource path
AWS_S3_QUOTES_PREFIX=quotes_requests
# Optional max upload size in MB (app still enforces its own limit)
# AWS_S3_MAX_FILE_MB=5

# Optional: show "Phone *" on PDP when you use PayFast
NEXT_PUBLIC_PAYFAST_CHECKOUT=1

# Alternative: custom backend that returns MERCHANT_ID + ACCESS_TOKEN (omit merchant+secured above)
# PAYFAST_ACCESS_TOKEN_URL=
# PAYFAST_TOKEN_AUTH_HEADER=
